# 기본: Git이 텍스트 여부를 판단, 저장소에는 LF로 정규화
* text=auto

# ── 셸 스크립트는 반드시 LF ──────────────────────────
# CRLF로 체크아웃되면 `sh: bad interpreter: No such file or directory`로
# 실행이 실패한다. Windows(Git Bash)와 Linux(Jenkins) 양쪽에서 동작해야 한다.
*.sh            text eol=lf
gradlew         text eol=lf
Jenkinsfile     text eol=lf

# ── Windows 전용 스크립트는 CRLF ─────────────────────
*.bat           text eol=crlf
*.cmd           text eol=crlf
gradlew.bat     text eol=crlf

# ── 바이너리 (변환 금지) ─────────────────────────────
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.jar binary
