# Render 배포용 백엔드 Dockerfile 템플릿
#
# backend/ 가 아직 Spring 프로젝트로 초기화되지 않아 여기 템플릿으로만
# 둡니다. 백엔드 담당자가 start.spring.io로 프로젝트를 만든 뒤,
# 이 파일을 backend/Dockerfile 로 복사해서 쓰면 됩니다.
#
# 전제 (docs/ARCHITECTURE.md §2.2, §8.1):
#   - Gradle 빌드, Java 21, Render Free (메모리 512MB → -Xmx400m)
#   - 헬스체크: /actuator/health (Spring Boot Actuator)
#
# 규약 상세: docs/BACKEND_DEPLOY.md

# ── 1단계: 빌드 ──────────────────────────────────────────────
FROM gradle:8-jdk21 AS build
WORKDIR /app
COPY . .
RUN gradle bootJar --no-daemon -x test

# ── 2단계: 실행 (JRE만 포함해 이미지 크기 최소화) ──────────────
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /app/build/libs/*.jar app.jar

ENV JAVA_OPTS="-Xmx400m"
EXPOSE 8080

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
