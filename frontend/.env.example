# 이 파일을 .env.local로 복사해서 쓴다 (.env.local은 커밋되지 않는다)
#   cp .env.example .env.local

# 백엔드 주소 — 서버 전용. ⚠️ NEXT_PUBLIC_ 접두사를 붙이지 않는다
# (붙이면 클라이언트 번들에 그대로 박힌다 — NFR-SEC-22)
API_ORIGIN=http://localhost:8080

# 1 = 백엔드 없이 mock으로 개발  /  0 = 실제 백엔드 호출
NEXT_PUBLIC_USE_MOCK=1

# 절대 URL 생성용 (OG 태그·sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
